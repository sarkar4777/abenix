      2.4256,
      10.7651,
      0.3074,
      -3.402,
      -1.0425,
      -0.9134,
      3.703
    ],
    "intercept_": 26.4486,
    "ablation_12_feature_only_r2": 0.6534,
    "ablation_12_feature_only_rmse_usd_mt": 7.6167,
    "ablation_8_feature_only_r2": 0.6088,
    "ablation_8_feature_only_rmse_usd_mt": 8.0918,
    "freight_features_added": [
