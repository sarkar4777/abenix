# Unpinned on purpose. A pinned patch tag stops picking up Alpine security
# updates the moment it is cut, and this set is what the cluster and ACR build,
# so it is the one that has to stay current. apps/web/Dockerfile is the CI set.
FROM node:20-alpine AS base

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
RUN npm ci --workspace=@abenix/web --include-workspace-root --include=optional 2>/dev/null || npm install --include=optional

FROM base AS builder
WORKDIR /app
RUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-* -rf 2>/dev/null; true
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Next.js inlines NEXT_PUBLIC_* into the bundle at build time, so they must be set here.
# Empty means the code's own fallback, which is what an unset variable gave before.
ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_APP_URL=""
ARG NEXT_PUBLIC_ENABLE_MONETIZATION=""
ARG NEXT_PUBLIC_AUDIT_NATIVE=""
ARG NEXT_PUBLIC_GRAFANA_URL=""
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_ENABLE_MONETIZATION=${NEXT_PUBLIC_ENABLE_MONETIZATION}
ENV NEXT_PUBLIC_AUDIT_NATIVE=${NEXT_PUBLIC_AUDIT_NATIVE}
ENV NEXT_PUBLIC_GRAFANA_URL=${NEXT_PUBLIC_GRAFANA_URL}
RUN npm run build --workspace=@abenix/web

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
# The base image's Alpine packages trail the patched builds — libssl3 alone
# accounted for fifty Trivy findings. npm and yarn are build tools and the
# runtime only ever runs `node apps/web/server.js`, so their vendored
# node_modules are pure surface. Removing them takes the tar, minimatch,
# brace-expansion and sigstore findings with them.
RUN apk upgrade --no-cache \
 && rm -rf /usr/local/lib/node_modules/npm \
           /usr/local/bin/npm /usr/local/bin/npx \
           /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
USER nextjs
EXPOSE 3000
ENV PORT=3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q --spider http://localhost:3000/ || exit 1
CMD ["node", "apps/web/server.js"]
