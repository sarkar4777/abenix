# Unpinned on purpose. A pinned patch tag stops picking up Debian security
# updates the moment it is cut, and this set is what the cluster and ACR build,
# so it is the one that has to stay current. apps/*/Dockerfile is the CI set.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

FROM base AS deps
COPY apps/agent-runtime/pyproject.toml ./pyproject.toml
COPY apps/agent-runtime/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir . && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir uvicorn fastapi boto3

FROM base AS runtime
# The base tag's Debian packages trail the patched builds, so upgrade them
# rather than wait for a new python:3.12-slim to be cut. pip is upgraded in the
# deps stage instead of here, because this stage's site-packages is wiped
# and replaced by the deps stage's copy below.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
# COPY merges into the destination rather than replacing it, so the base
# image's own dist-info directories survive next to the ones copied in and
# Trivy reports the stale versions. Clear the directory first so what lands
# here is exactly what the deps stage resolved.
RUN rm -rf /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin
COPY packages/db/ ./packages/db/
COPY apps/agent-runtime/ ./apps/agent-runtime/
# consumer.py imports app.core.execution_state to share Redis primitives with the API.
RUN mkdir -p ./apps/api/app/core
COPY apps/api/app/__init__.py ./apps/api/app/__init__.py
COPY apps/api/app/core/__init__.py ./apps/api/app/core/__init__.py
COPY apps/api/app/core/execution_state.py ./apps/api/app/core/execution_state.py
# Runtime-side emit_outcome_metric path needs failure_codes.py to be
# importable. Without this the agent-runtime pod fails the import and
# every executions_completed_total / executions_failed_total bump from
# the runtime side is silently dropped, leaving the dashboard panels
# with HELP/TYPE lines and zero samples.
COPY apps/api/app/core/failure_codes.py ./apps/api/app/core/failure_codes.py
COPY apps/api/app/core/telemetry.py ./apps/api/app/core/telemetry.py
# connector_call loads its presets through this module
COPY apps/api/app/core/connector_presets.py ./apps/api/app/core/connector_presets.py
# held moderation content is encrypted with the same envelope as the API
COPY apps/api/app/core/crypto.py ./apps/api/app/core/crypto.py
# Standalone-app code assets — the code_asset tool unpacks and executes
# the agentforge.yaml + main.py bundles inside the runtime container.
# Without these copies, agents that invoke code_asset(name='contractiq-risk-quant')
# return "Code asset not found".
COPY contractiq/code-assets/ ./contractiq/code-assets/
COPY contractiq/runtime/ ./contractiq/runtime/
COPY contractiq/__init__.py ./contractiq/__init__.py
COPY wingman/code-assets/ ./wingman/code-assets/
COPY industrial-iot/code-assets/ ./industrial-iot/code-assets/
WORKDIR /app/apps/agent-runtime

ENV PYTHONPATH="/app/packages/db:/app/apps/agent-runtime:/app/apps/api"

RUN adduser --system --uid 1001 appuser
USER appuser

EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')" || exit 1
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
