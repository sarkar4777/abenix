# Unpinned on purpose. A pinned patch tag stops picking up Debian security
# updates the moment it is cut, and this set is what the cluster and ACR build,
# so it is the one that has to stay current. apps/*/Dockerfile is the CI set.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

FROM base AS deps
# Install API dependencies from pyproject.toml
COPY apps/api/pyproject.toml ./pyproject.toml
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir .
# Install agent-runtime dependencies (shared engine code)
COPY apps/agent-runtime/requirements.txt ./requirements-runtime.txt
RUN pip install --no-cache-dir -r requirements-runtime.txt 2>/dev/null || true

FROM base AS runtime
# The base tag's Debian packages trail the patched builds, so upgrade them
# rather than wait for a new python:3.12-slim to be cut. pip is upgraded in the
# deps stage instead of here, because this stage's site-packages is wiped
# and replaced by the deps stage's copy below.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
# COPY merges into the destination rather than replacing it, so the base
# image's own dist-info directories survive next to the ones copied in and
# Trivy reports the stale versions. Clear the directory first so what lands
# here is exactly what the deps stage resolved.
RUN rm -rf /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin
COPY packages/db/ ./packages/db/
COPY infra/use_cases_catalog.json ./infra/use_cases_catalog.json
COPY packages/sdk/python/ ./packages/sdk/python/
COPY apps/agent-runtime/ ./apps/agent-runtime/
COPY apps/api/ ./apps/api/
# Sample ML models + code assets so seed_ml_models.py / seed_code_assets.py
# can backfill the registry on first deploy. Without these the in-cluster
# seed scripts find nothing and /api/ml-models + /api/code-assets stay empty.
COPY aimodels/ ./aimodels/
# Use-case-scoped samples live alongside the standalone app source. The
# seed scripts walk these roots looking for `*.meta.json` (ML) and
# `agentforge.yaml` (code asset).
COPY industrial-iot/aimodels/ ./industrial-iot/aimodels/
COPY industrial-iot/code-assets/ ./industrial-iot/code-assets/
COPY wingman/code-assets/ ./wingman/code-assets/
COPY wingman/ml-models/ ./wingman/ml-models/
COPY contractiq/aimodels/ ./contractiq/aimodels/
COPY contractiq/code-assets/ ./contractiq/code-assets/
COPY pharmavigil/aimodels/ ./pharmavigil/aimodels/
COPY pharmavigil/code-assets/ ./pharmavigil/code-assets/
WORKDIR /app/apps/api

ENV PYTHONPATH="/app/packages/db:/app/packages/sdk/python:/app/apps/agent-runtime"

RUN adduser --system --uid 1001 appuser
USER appuser

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')" || exit 1
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
