{
  "uid": "abenix-resource-invocations",
  "title": "Abenix — Resource Invocations",
  "tags": ["abenix", "observability", "v1.4"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {"from": "now-1h", "to": "now"},
  "annotations": {"list": []},
  "templating": {
    "list": [
      {
        "name": "code_asset_id",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(abenix_code_asset_invocations_total, code_asset_id)",
        "multi": true,
        "includeAll": true,
        "current": {"selected": false, "text": "All", "value": "$__all"}
      },
      {
        "name": "ml_model_id",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(abenix_ml_model_invocations_total, ml_model_id)",
        "multi": true,
        "includeAll": true,
        "current": {"selected": false, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Code Asset Invocations (rate / 5m) by asset",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (code_asset_id, status) (rate(abenix_code_asset_invocations_total{code_asset_id=~\"$code_asset_id\"}[5m]))",
          "legendFormat": "{{code_asset_id}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 20, "stacking": {"mode": "normal"}}}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Code Asset P95 Duration (s)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, code_asset_id) (rate(abenix_code_asset_duration_seconds_bucket{code_asset_id=~\"$code_asset_id\"}[5m])))",
          "legendFormat": "{{code_asset_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "ML Model Predictions (rate / 5m) by model + op",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (ml_model_id, operation, status) (rate(abenix_ml_model_invocations_total{ml_model_id=~\"$ml_model_id\"}[5m]))",
          "legendFormat": "{{ml_model_id}} {{operation}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 20, "stacking": {"mode": "normal"}}}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ML Model P95 Latency (s)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, ml_model_id) (rate(abenix_ml_model_duration_seconds_bucket{ml_model_id=~\"$ml_model_id\"}[5m])))",
          "legendFormat": "{{ml_model_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "ML Cumulative Cost (USD)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 6},
      "targets": [
        {
          "expr": "sum by (ml_model_id) (abenix_ml_model_cost_usd_total{ml_model_id=~\"$ml_model_id\"})",
          "legendFormat": "{{ml_model_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 4}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Knowledge Base Queries (rate / 5m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 6},
      "targets": [
        {
          "expr": "sum by (kb_collection_id, status) (rate(abenix_kb_query_invocations_total[5m]))",
          "legendFormat": "{{kb_collection_id}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Code Asset 24h error rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 22, "w": 8, "h": 5},
      "targets": [
        {
          "expr": "sum(increase(abenix_code_asset_invocations_total{status=\"error\"}[24h])) / clamp_min(sum(increase(abenix_code_asset_invocations_total[24h])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.10}]}}}
    },
    {
      "id": 8,
      "type": "stat",
      "title": "ML 24h error rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 22, "w": 8, "h": 5},
      "targets": [
        {
          "expr": "sum(increase(abenix_ml_model_invocations_total{status=\"error\"}[24h])) / clamp_min(sum(increase(abenix_ml_model_invocations_total[24h])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.10}]}}}
    },
    {
      "id": 9,
      "type": "stat",
      "title": "ML 24h spend (USD)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 22, "w": 8, "h": 5},
      "targets": [
        {
          "expr": "sum(increase(abenix_ml_model_cost_usd_total[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}}
    }
  ]
}
