{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "title": "Abenix — Scaling Ops",
  "uid": "abenix-scaling-ops",
  "version": 1,
  "schemaVersion": 38,
  "timezone": "",
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "tags": ["abenix", "scaling"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Executions (1h) — by pool",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (pool) (increase(abenix_execution_duration_seconds_count[1h]))",
        "legendFormat": "{{pool}}",
        "refId": "A"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue depth — by pool",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "max by (pool) (abenix_queue_depth{pool=~\".+\"})",
        "legendFormat": "{{pool}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency — by pool (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(abenix_execution_duration_seconds_bucket[5m])))",
        "legendFormat": "p95 {{pool}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rate-limit hits — per (tenant, agent)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (tenant_id, agent_slug) (rate(abenix_rate_limit_hits_total[5m]))",
        "legendFormat": "{{tenant_id}}/{{agent_slug}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM errors — by provider (10m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (provider, error_type) (increase(abenix_llm_errors_total[10m]))", "legendFormat": "{{provider}} {{error_type}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Token spend — by provider and model (1h)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sort_desc(sum by (provider, model) (increase(abenix_llm_cost_usd_provider_total[1h])))",
        "format": "table",
        "instant": true,
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    }
  ]
}
