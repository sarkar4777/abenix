# ── Database ───────────────────────────────────────────────
POSTGRES_USER=abenix
POSTGRES_PASSWORD=abenix
POSTGRES_DB=abenix
DATABASE_URL=postgresql+asyncpg://abenix:abenix@localhost:5432/abenix

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]

# JWT signing keys — used by /api/auth to issue access tokens. Generate with
# `openssl genrsa -out jwt-private.pem 2048` then `openssl rsa -in jwt-private.pem
# -pubout -out jwt-public.pem`. Both must be the matching pair. Treat as
# secrets; commit only placeholders.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Internal platform key the deploy script mints for standalone-app keys.
# Used by Abenix admin tooling for first-time tenant onboarding. Optional in
# local dev; required in cloud where the deploy script auto-generates it.
ABENIX_PLATFORM_API_KEY=

# ── Web ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── LLM Providers ─────────────────────────────────────────
# All four are read at runtime. Set whichever ones your tenants have access to.
# The fallback ladder is db-driven (llm_model_pricing.fallback_to) plus a
# layer-2 hardcoded dict (apps/agent-runtime/engine/llm_router.py) so a deploy
# with only AZURE_OPENAI_API_KEY still resolves model requests sensibly.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Either AZURE_OPENAI_ENDPOINT or AZURE_OPENAI_API_BASE works — both are read.
# The endpoint should NOT include the `/openai/deployments` path; the SDK
# appends that automatically. Strip trailing slashes too.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# ── Embedding model (RAG ingest + search) ─────────────────
# The chain mirrors the LLM ladder. When AZURE_OPENAI_API_KEY +
# AZURE_OPENAI_ENDPOINT are present, embed calls route to AsyncAzureOpenAI
# using AZURE_EMBEDDING_DEPLOYMENT as the deployment name. If Azure errors
# live (quota, transport) or no Azure key is set, the call falls forward to
# OpenAI direct API using OPENAI_EMBEDDING_MODEL. If neither provider is
# reachable, the document is marked DEGRADED with a clear error_message
# (never silently stored as zero-vector READY).
# Sample values: text-embedding-3-small (1536 dim, default),
# text-embedding-3-large (3072 dim), text-embedding-ada-002 (1536 dim, legacy).
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# ── Agent Runtime Mode ────────────────────────────────────
# embedded = run agents inline in API process (default, local dev)
# remote   = delegate to runtime pods via HTTP (production K8s)
RUNTIME_MODE=embedded
RUNTIME_URL=http://localhost:8001

# ── File Storage ─────────────────────────────────────────
# Backend: local (filesystem), s3 (S3-compatible: AWS, MinIO, R2), azure (Blob)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/uploads
# For MinIO (local K8s): STORAGE_BACKEND=s3, STORAGE_S3_ENDPOINT=http://minio:9000
# For AWS S3: STORAGE_BACKEND=s3, STORAGE_S3_BUCKET=your-bucket
# For Azure: STORAGE_BACKEND=azure, STORAGE_AZURE_CONNECTION_STRING=...
STORAGE_S3_BUCKET=abenix-uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_AZURE_CONNECTION_STRING=
STORAGE_AZURE_CONTAINER=abenix-files

EXPORT_DIR=./data/exports

# ── RAG / Vector Store ────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentforge-knowledge
UPLOAD_DIR=./data/uploads

# ── Knowledge Engine / Neo4j ─────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=abenix
NEO4J_DATABASE=neo4j

# ── Celery ─────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── NATS JetStream (agent-runtime queue + KEDA scaling) ──
# The agent-runtime can dispatch jobs via NATS instead of Celery. KEDA
# ScaledObjects watch the JetStream queue depth and scale runtime pods
# accordingly (chat / default / heavy-reasoning / long-running pools). NATS
# runs as its own StatefulSet (abenix-nats-0) — NOT inside an api/web pod.
#
# Local (docker-compose / minikube):
#   NATS_URL=nats://127.0.0.1:4222
# In-cluster (AKS / minikube):
#   NATS_URL=nats://abenix-nats:4222
# Optional auth:
#   NATS_USER=...
#   NATS_PASSWORD=...
#
# Selecting the backend:
#   QUEUE_BACKEND=nats     # use NATS JetStream (required for KEDA queue scaling)
#   QUEUE_BACKEND=celery   # use Redis-backed Celery (default; no autoscaling)
NATS_URL=nats://abenix-nats:4222
QUEUE_BACKEND=nats

# ── PgAdmin (optional, use `docker compose --profile tools up`) ─
PGADMIN_EMAIL=admin@abenix.dev
PGADMIN_PASSWORD=admin

# === Search / News / OracleNet ===
# All of these run on the providers' free dev tiers and are safe to ship as
# shared starter keys — rate limits are low but enough for local dev plus
# the canonical UAT pass. Replace with your own keys for production traffic.
# FRED + SERPER are left blank: FRED needs a per-developer registration,
# SERPER is an optional alternate search backend.
NEXT_PUBLIC_ORACLENET_API_KEY=af_oraclenet_default_key
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
SERPER_API_KEY=
SEARCH_PROVIDER=tavily
FRED_API_KEY=
NEWS_API_KEY=
MEDIASTACK_API_KEY=

# === Energy / commodities ===
# EMBER + EIA + ENTSOE + FMP are free-tier government / industry feeds used
# by ContractIQ and Wingman for grid, fuel and macro signals.
EMBER_API_KEY=
EIA_API_KEY=
ENTSOE_API_KEY=
FMP_API_KEY=

# === Sanctions / corporate registry ===
# OpenSanctions free dev key. OpenCorporates / Companies House / Congress.gov
# stay blank — each needs an individual developer registration that the
# providers tie to a single billing account.
OPENSANCTIONS_API_KEY=
OPENCORPORATES_API_KEY=
COMPANIES_HOUSE_API_KEY=
CONGRESS_GOV_API_KEY=

# === Market data ===
# Equities / commodities / fundamentals via Alpha Vantage. Free tier works
# for low-volume Wingman + ContractIQ tickers; paid tier unlocks intraday.
ALPHA_VANTAGE_API_KEY=
# AIS vessel-tracking feed used by the ais_stream tool for marine commodity
# flows (LNG / tanker positions). Sign up at aisstream.io.
AISSTREAM_API_KEY=

# === ContractIQ ===
CONTRACTIQ_JWT_SECRET=change-me-in-production

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ZAPIER_NLA_KEY=
DEEPL_API_KEY=

# ── Sandboxed Job Runner ───────────────────────────────────
# The sandboxed_job tool runs one-shot commands in isolated
# containers (kubernetes Job in cluster, docker on host). Both
# vars MUST be set or the tool returns "disabled". Allow-list
# only images the tool may run.
SANDBOXED_JOB_ENABLED=true
SANDBOXED_JOB_ALLOWED_IMAGES=alpine:3.20,busybox:1.36,python:3.12-slim,gcc:13,golang:1.22-alpine,rust:1.80-slim,eclipse-temurin:21-jdk,node:20-alpine,sbtscala/scala-sbt:eclipse-temurin-jammy-21.0.2_13_1.10.0_3.4.2,zenika/kotlin:1.9.24-jdk-jre-alpine-slim,mcr.microsoft.com/dotnet/sdk:8.0,ruby:3.3-alpine

# ── Meeting Representative (LiveKit) ──────────────────────
# The Meeting Representative agent joins meetings via LiveKit. Self-host
# `livekit/livekit-server` or use LiveKit Cloud (https://livekit.io/cloud).
# LIVEKIT_MEET_URL is optional and only used to generate a "Join as
# participant" link in the UI.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_MEET_URL=https://meet.livekit.io

# TTS voice — OpenAI voices: alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_VOICE=alloy

# Voice cloning via ElevenLabs. Without this, the /api/persona/voice/upload
# endpoint is disabled and the bot uses OpenAI's generic voices only.
# The Meeting Representative ALWAYS falls back to OpenAI if the user hasn't
# recorded consent — there's a hard consent gate in meeting_speak.
ELEVENLABS_API_KEY=

# Optional: webhook for defer-to-human notifications (Slack incoming webhook
# is the default format; any JSON POST receiver works)
DEFER_NOTIFY_WEBHOOK_URL=

# Stubs for future providers — leave empty until you've completed the
# Azure tenant / Zoom marketplace review steps documented in README.
TEAMS_GRAPH_TENANT_ID=
TEAMS_GRAPH_CLIENT_ID=
TEAMS_GRAPH_CLIENT_SECRET=
TEAMS_BOT_CERT_PATH=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=


