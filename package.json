{
  "name": "abenix",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=apps/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:web": "npm run test --workspace=apps/web",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "start": "bash scripts/dev-local.sh",
    "stop": "bash scripts/dev-local.sh --stop"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "prettier": "^3.2.0",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.0",
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "overrides": {
    "tar": "^7.4.3",
    "minimatch": "^10.0.1",
    "glob": "^11.0.0",
    "picomatch": "4.0.4",
    "cross-spawn": "^7.0.6",
    "uuid": "14.0.0",
    "flatted": "^3.4.2",
    "@babel/runtime": "^7.26.10",
    "diff": "^7.0.0",
    "rollup": "^4.60.2",
    "semver": "^7.7.2",
    "next": {
      "postcss": "^8.5.13"
    },
    "@eslint/eslintrc": {
      "minimatch": "^3.1.5"
    },
    "vite": "^6.4.2",
    "esbuild": "^0.25.12"
  }
}
